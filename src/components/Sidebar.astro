---
// Sidebar.astro
// The left menu. It is the same on every page.
import { projects } from '../data/projects';
import { companies } from '../data/experience';

// One menu entry: the text to show and the page it opens.
interface NavItem {
  label: string;
  href: string;
}

// Build the three menu groups from the data files.
const projectItems: NavItem[] = [];
for (const project of projects) {
  projectItems.push({ label: project.title, href: `/projects/${project.slug}` });
}

const experienceItems: NavItem[] = [];
for (const company of companies) {
  experienceItems.push({ label: company.name, href: `/experience/${company.slug}` });
}

const otherItems: NavItem[] = [
  { label: 'Poker', href: '/poker' },
  { label: 'About', href: '/about' },
];

// Give every entry a running number: 01, 02, 03 ...
const allItems = [...projectItems, ...experienceItems, ...otherItems];
const numbers = new Map<string, string>();
for (let i = 0; i < allItems.length; i++) {
  numbers.set(allItems[i].href, String(i + 1).padStart(2, '0'));
}

// The page the visitor is on now, without a trailing slash.
const currentPath = Astro.url.pathname.replace(/\/$/, '');

// Pick the link style. The current page shows in green.
function linkClass(href: string): string {
  if (href === currentPath) {
    return 'text-felt';
  }
  return 'hover:text-felt hover:underline';
}
---

<nav aria-label="Site" class="flex flex-col gap-9 md:w-64 md:flex-shrink-0 md:sticky md:top-14 md:self-start">
  <!-- Top row: name on the left, menu button on the right (phone only) -->
  <div class="flex items-center justify-between">
    <!-- Name: always links home -->
    <a href="/" class="font-bold text-xl hover:text-felt">Quincy Karns</a>

    <button
      id="menu-button"
      type="button"
      class="md:hidden w-11 h-11 -mr-3 flex items-center justify-center hover:text-felt"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="site-menu"
    >
      <!-- Three dots when closed -->
      <svg id="menu-icon-open" width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <circle cx="5" cy="12" r="2" />
        <circle cx="12" cy="12" r="2" />
        <circle cx="19" cy="12" r="2" />
      </svg>
      <!-- A cross when open -->
      <svg id="menu-icon-close" class="hidden" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <path d="M6 6l12 12M18 6L6 18" />
      </svg>
    </button>
  </div>

  <!-- The menu: always shown on a computer, hidden behind the button on a phone -->
  <div id="site-menu" class="hidden md:flex flex-col gap-9">
    <!-- Projects -->
    <div class="flex flex-col gap-1">
      <span class="text-muted"><span class="text-felt">//</span> projects</span>
      {projectItems.map((item) => (
        <a href={item.href} class={linkClass(item.href)}>
          {numbers.get(item.href)}&nbsp;&nbsp;{item.label}
        </a>
      ))}
    </div>

    <!-- Experience -->
    <div class="flex flex-col gap-1">
      <span class="text-muted"><span class="text-felt">//</span> experience</span>
      {experienceItems.map((item) => (
        <a href={item.href} class={linkClass(item.href)}>
          {numbers.get(item.href)}&nbsp;&nbsp;{item.label}
        </a>
      ))}
    </div>

    <!-- Poker and About -->
    <div class="flex flex-col gap-1">
      {otherItems.map((item) => (
        <a href={item.href} class={linkClass(item.href)}>
          {numbers.get(item.href)}&nbsp;&nbsp;{item.label}
        </a>
      ))}
    </div>
  </div>
</nav>

<script>
  // Show or hide the menu on a phone when the visitor taps the button.
  const menuButton = document.getElementById('menu-button');
  const siteMenu = document.getElementById('site-menu');
  const openIcon = document.getElementById('menu-icon-open');
  const closeIcon = document.getElementById('menu-icon-close');

  if (menuButton && siteMenu && openIcon && closeIcon) {
    menuButton.addEventListener('click', () => {
      const isOpen = menuButton.getAttribute('aria-expanded') === 'true';

      // Flip the menu and the icon to the other state.
      siteMenu.classList.toggle('hidden', isOpen);
      siteMenu.classList.toggle('flex', !isOpen);
      openIcon.classList.toggle('hidden', !isOpen);
      closeIcon.classList.toggle('hidden', isOpen);

      // Keep screen readers in sync.
      menuButton.setAttribute('aria-expanded', String(!isOpen));
      menuButton.setAttribute('aria-label', isOpen ? 'Open menu' : 'Close menu');
    });
  }
</script>
