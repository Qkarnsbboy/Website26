---
// Poker.astro

const stats = [
  { label: 'Lifetime Profit', value: '$35,000+' },
  { label: '$/hr', value: '$75/hr' },
  { label: 'ROI', value: '40%' },
  { label: 'Sharpe Ratio', value: '0.38' },
  { label: 'BB/100', value: '72' },
];

const skills = [
  'Risk Management',
  'Expected Value',
  'Probabilistic Thinking',
  'Decision-Making Under Uncertainty',
  'Emotional Discipline',
  'Bankroll Management',
  'Pattern Recognition',
  'Game Selection',
];
---

<section id="poker" class="py-24">
  <div class="max-w-5xl mx-auto px-6">
    <h2 class="text-2xl font-semibold text-accent mb-6">Poker</h2>

    <!-- Text left, photo right -->
    <div class="flex flex-col md:flex-row gap-12 mb-12">
      <div class="flex-1">
        <p class="text-gray-400 text-lg leading-relaxed">
          Poker is my favorite hobby. From my first time playing with my friends in their college dorm room,
          to taking on thousands of professionals at the World Series of Poker in Las Vegas, I have never lost my love for the game.
        </p>
        <p class="text-gray-400 text-lg leading-relaxed mt-4">          
          Poker combines complex logical and mathematical reasoning, with deep understanding of human psychology and emotion.
          These skills help me in my everyday and professional life by allowing me to make better decisions with incomplete information.
        </p>
        <p class="text-gray-400 text-lg leading-relaxed mt-4">
          You can find me grinding at the local $1/$3 and $2/$5 tables at casinos and home games around NYC. Occasionally, I take shots
          at tournament series like the World Series of Poker (WSOP) and World Poker Tour (WPT).
        </p>
      </div>

      <!-- Photo + caption -->
      <div class="flex-shrink-0">
        <div class="relative w-96 rounded-xl bg-slate-800 border border-slate-700 overflow-hidden">
          <img src="/assets/PokerPic1.jpeg" alt="Poker" class="w-full h-full object-cover" />
          <!-- Location badge -->
          <div class="absolute bottom-3 right-3 flex items-center gap-1.5 bg-slate-900/80 backdrop-blur-sm text-accent text-xs font-semibold uppercase tracking-widest px-3 py-1.5 rounded-full">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/>
              <circle cx="12" cy="10" r="3"/>
            </svg>
            Las Vegas, NV
          </div>
        </div>
        <p class="text-gray-500 text-sm italic mt-3">WSOP Event #67: $300 Gladiators of Poker - Day 1</p>
        <!-- Hendon Mob callout -->
        <a
          href="https://pokerdb.thehendonmob.com/player.php?a=r&n=1270221"
          target="_blank"
          rel="noopener noreferrer"
          class="mt-4 w-96 flex items-center gap-3 bg-slate-800 border border-slate-700 rounded-xl px-4 py-3.5 hover:border-accent/40 transition-all group"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="currentColor" class="text-accent flex-shrink-0">
            <path d="M12 2c-.5 0-8 6.7-8 11.2 0 2.3 1.9 4.2 4.2 4.2 1.3 0 2.4-.6 3.2-1.5-.1 2-.9 3.4-2.1 4.1h5.4c-1.2-.7-2-2.1-2.1-4.1.8.9 1.9 1.5 3.2 1.5 2.3 0 4.2-1.9 4.2-4.2C20 8.7 12.5 2 12 2z"/>
          </svg>
          <div class="min-w-0">
            <p class="text-sm text-white font-medium">Track my live tourney winnings</p>
            <p class="text-xs text-gray-400 group-hover:text-accent transition-colors">The Hendon Mob</p>
          </div>
        </a>

        <!-- Instagram callout -->
        <a
          href="https://www.instagram.com/qballplayspoker"
          target="_blank"
          rel="noopener noreferrer"
          class="mt-3 w-96 flex items-center gap-3 bg-slate-800 border border-slate-700 rounded-xl px-4 py-3.5 hover:border-accent/40 transition-all group"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="currentColor" class="text-accent flex-shrink-0">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.76 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
          </svg>
          <div class="min-w-0">
            <p class="text-sm text-white font-medium">Follow my poker journey here</p>
            <p class="text-xs text-gray-400 group-hover:text-accent transition-colors">@qballplayspoker</p>
          </div>
        </a>
      </div>
    </div>

    <!-- Stats -->
    <h4 class="text-xs font-semibold uppercase tracking-widest text-gray-400 mb-4">
      Stats
    </h4>
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-4 mb-12">
      {stats.map((stat) => (
        <div class="bg-slate-800 border border-slate-700 rounded-xl p-5 text-center hover:border-accent/40 transition-all">
          <p class="text-2xl font-bold text-accent mb-1">{stat.value}</p>
          <p class="text-xs font-semibold uppercase tracking-widest text-gray-400">{stat.label}</p>
        </div>
      ))}
    </div>

    <!-- Transferable skills -->
    <h4 class="text-xs font-semibold uppercase tracking-widest text-gray-400 mb-4">
      Transferable Skills
    </h4>
    <div class="flex flex-wrap gap-2">
      {skills.map((skill) => (
        <span class="text-sm bg-slate-800 text-gray-300 px-3 py-1.5 rounded-full font-medium hover:bg-accent/20 hover:text-accent transition-colors">
          {skill}
        </span>
      ))}
    </div>
  </div>
</section>
