---
// Navbar.astro
---

<header class="fixed top-0 left-0 right-0 z-50 bg-slate-900/90 backdrop-blur-sm border-b border-slate-700">
  <nav class="max-w-5xl mx-auto px-6 py-4 flex items-center justify-between">
    <div class="flex items-center gap-3">
      <div class="w-8 h-8 rounded-full bg-accent flex items-center justify-center flex-shrink-0">
        <span class="text-xs font-bold text-slate-900">QK</span>
      </div>
      <span class="text-lg font-semibold text-white tracking-tight">Quincy Karns</span>
    </div>
    <div class="hidden md:flex items-center gap-6">
      <a href="#about" class="text-sm text-gray-400 hover:text-accent transition-colors">About</a>
      <a href="#experience" class="text-sm text-gray-400 hover:text-accent transition-colors">Experience</a>
      <a href="#projects" class="text-sm text-gray-400 hover:text-accent transition-colors">Projects</a>
      <a href="#skills" class="text-sm text-gray-400 hover:text-accent transition-colors">Skills</a>
      <a
        href="/resume.pdf"
        target="_blank"
        rel="noopener noreferrer"
        class="text-sm px-4 py-1.5 rounded border border-accent text-accent hover:bg-accent hover:text-slate-900 transition-colors font-medium"
      >
        Resume
      </a>
    </div>
