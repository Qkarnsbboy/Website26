---
// Footer.astro
const year = new Date().getFullYear();
---

<footer class="border-t border-slate-800 py-10">
  <div class="max-w-5xl mx-auto px-6 flex flex-col sm:flex-row items-center justify-between gap-4">
    <p class="text-sm text-gray-500">&copy; {year} Quincy Karns</p>
    <div class="flex items-center gap-5">
      <a
        href="https://linkedin.com/in/quincykarns"
        target="_blank"
        rel="noopener noreferrer"
        class="text-sm text-gray-500 hover:text-accent transition-colors"
      >
        LinkedIn
      </a>
      <a
        href="https://github.com/quincykarns"
        target="_blank"
        rel="noopener noreferrer"
        class="text-sm text-gray-500 hover:text-accent transition-colors"
      >
        GitHub
      </a>
      <a
        href="mailto:qckarns@gmail.com"
        class="text-sm text-gray-500 hover:text-accent transition-colors"
      >
        Email
      </a>
    </div>
  </div>
</footer>
