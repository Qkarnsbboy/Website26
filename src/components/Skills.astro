---
// Skills.astro

const skillGroups = [
  {
    category: 'Languages',
    skills: ['C++', 'C#', 'Python', 'JavaScript', 'Java', 'SQL', 'HTML/CSS'],
  },
  {
    category: 'Frameworks & Tools',
    skills: ['ReactJS', 'Express.js', 'Git', 'Azure', 'Pandas', 'NumPy', 'Flask', 'SpringBoot', 'Bootstrap'],
  },
  {
    category: 'Finance',
    skills: [
      'Financial Derivatives',
      'Sensitivity Analysis',
      'Technology Due Diligence',
      'Advanced Finance',
      'Applied Statistics',
    ],
  },
  {
    category: 'Other',
    skills: [
      'Data Structures & Algorithms',
      'Systems Design',
      'Product Strategy',
      'Private Equity Diligence',
    ],
  },
];
---

<section id="skills" class="py-24 bg-slate-800">
  <div class="max-w-5xl mx-auto px-6">
    <h2 class="text-sm font-semibold uppercase tracking-widest text-accent mb-3">Skills</h2>
    <h3 class="text-3xl font-bold text-white mb-12">Technical &amp; domain knowledge</h3>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-10">
      {skillGroups.map((group) => (
        <div>
          <h4 class="text-xs font-semibold uppercase tracking-widest text-gray-400 mb-4">{group.category}</h4>
          <div class="flex flex-wrap gap-2">
            {group.skills.map((skill) => (
              <span class="text-sm bg-slate-800 text-gray-300 px-3 py-1.5 rounded-full font-medium hover:bg-accent/20 hover:text-accent transition-colors">
                {skill}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
