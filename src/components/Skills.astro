---
// Skills.astro

const skillGroups = [
  {
    category: 'Languages',
    skills: ['C++', 'C#', 'Python', 'JavaScript', 'Java', 'SQL', 'HTML/CSS'],
  },
  {
    category: 'Frameworks & Platforms',
    skills: ['ReactJS', 'Express.js', 'Node.js', 'Flask', 'SpringBoot', 'Azure', 'Git', 'Pandas', 'NumPy'],
  },
  {
    category: 'Customer-Facing',
    skills: [
      'Technical Discovery',
      'Requirements Gathering',
      'Stakeholder Communication',
      'Executive Presentations',
      'Technical Due Diligence',
      'Solution Design',
    ],
  },
  {
    category: 'Foundations',
    skills: [
      'Data Structures & Algorithms',
      'Systems Design',
      'Product Strategy',
      'Applied Statistics',
    ],
  },
];
---

<section id="skills" class="py-24 bg-slate-800">
  <div class="max-w-5xl mx-auto px-6">
    <h2 class="text-2xl font-semibold text-accent mb-6">Skills</h2>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-10">
      {skillGroups.map((group) => (
        <div>
          <h4 class="text-xs font-semibold uppercase tracking-widest text-gray-400 mb-4">{group.category}</h4>
          <div class="flex flex-wrap gap-2">
            {group.skills.map((skill) => (
              <span class="text-sm bg-slate-800 text-gray-300 px-3 py-1.5 rounded-full font-medium hover:bg-accent/20 hover:text-accent transition-colors">
                {skill}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
