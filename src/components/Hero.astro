---
// Hero.astro
---

<section class="min-h-screen flex items-center pt-20">
  <div class="max-w-5xl mx-auto px-6 py-24 flex flex-col-reverse md:flex-row items-center gap-12">
    <!-- Text -->
    <div class="flex-1">
      <p class="text-accent font-medium text-sm uppercase tracking-widest mb-3">Hi, I'm</p>
      <h1 class="text-5xl font-bold text-white leading-tight mb-4">Quincy Karns</h1>
      <div class="flex flex-col gap-1 text-lg text-gray-400 mb-8">
        <span>Technology Strategy consultant at Strategy&amp;</span>
        <span>Former Software Engineer at Microsoft</span>
        <span>USC Computer Science &amp; Business graduate</span>
        <span>Avid poker player and markets enthusiast</span>
        <span>Pursuing a career in Sales &amp; Trading</span>
      </div>
      <!-- Icon links -->
      <div class="flex items-center gap-5">
        <a
          href="https://linkedin.com/in/quincykarns"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="LinkedIn"
          class="text-gray-400 hover:text-accent transition-colors"
        >
          <!-- LinkedIn icon -->
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
          </svg>
        </a>
        <a
          href="https://github.com/quincykarns"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="GitHub"
          class="text-gray-400 hover:text-accent transition-colors"
        >
          <!-- GitHub icon -->
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/>
          </svg>
        </a>
        <a
          href="mailto:qckarns@gmail.com"
          aria-label="Email"
          class="flex items-center gap-2 text-gray-400 hover:text-accent transition-colors"
        >
          <!-- Email icon -->
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect width="20" height="16" x="2" y="4" rx="2"/>
            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
          </svg>
          <span class="text-sm">qckarns@gmail.com</span>
        </a>
      </div>
    </div>

    <!-- Headshot placeholder -->
    <div class="flex-shrink-0 flex flex-col items-center gap-2">
      <div class="w-48 h-48 md:w-56 md:h-56 rounded-full bg-slate-800 border-2 border-slate-700 flex items-center justify-center overflow-hidden">
        <img src="/assets/QK_Headshot2.jpg" alt="Quincy Karns" class="w-[185%] h-[185%] object-cover object-center" />
      </div>
      <p class="text-gray-500 text-sm">New York, NY</p>
    </div>
  </div>
</section>
