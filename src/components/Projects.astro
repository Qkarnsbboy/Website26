---
// Projects.astro

const projects = [
  {
    title: 'Options Pricing Model',
    description: 'In progress — implementing Black-Scholes and binomial tree pricing models in Python with an interactive payoff visualizer.',
    tags: ['Python', 'Finance', 'Coming Soon'],
    status: 'in-progress',
    link: null,
  },
  {
    title: 'Algorithmic Trading Backtest',
    description: 'Planned — backtesting a momentum-based equity strategy using historical market data. Will include performance metrics (Sharpe, max drawdown).',
    tags: ['Python', 'Quantitative', 'Planned'],
    status: 'planned',
    link: null,
  },
  {
    title: 'Market Data Dashboard',
    description: 'Planned — a real-time dashboard pulling live price data and displaying technical indicators. Leveraging C++ for data processing.',
    tags: ['C++', 'Python', 'Planned'],
    status: 'planned',
    link: null,
  },
];
---

<section id="projects" class="py-24 bg-slate-800">
  <div class="max-w-5xl mx-auto px-6">
    <h2 class="text-sm font-semibold uppercase tracking-widest text-accent mb-3">Projects</h2>
    <h3 class="text-3xl font-bold text-white mb-4">What I'm building</h3>
    <p class="text-gray-400 mb-12 max-w-xl">
      Currently building out finance-focused projects. Check back soon — links will be added as
      work is completed and published to GitHub.
    </p>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {projects.map((project) => (
        <div class="bg-slate-900 rounded-xl border border-slate-700 p-6 flex flex-col gap-4 hover:shadow-md hover:border-accent/40 transition-all">
          <!-- Status badge -->
          <div class="flex items-center justify-between">
            <span class={`text-xs font-medium px-2.5 py-1 rounded-full ${
              project.status === 'in-progress'
                ? 'bg-yellow-900/30 text-yellow-400'
                : 'bg-slate-700 text-gray-400'
            }`}>
              {project.status === 'in-progress' ? 'In Progress' : 'Planned'}
            </span>
          </div>

          <div>
            <h4 class="text-base font-semibold text-white mb-2">{project.title}</h4>
            <p class="text-sm text-gray-400 leading-relaxed">{project.description}</p>
          </div>

          <!-- Tags -->
          <div class="flex flex-wrap gap-2 mt-auto">
            {project.tags.map((tag) => (
              <span class="text-xs bg-slate-700 text-gray-300 px-2 py-0.5 rounded">{tag}</span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
