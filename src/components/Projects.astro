---
// Projects.astro

const projects = [
  {
    title: 'Poker Hand Analyzer',
    description: 'Reviews a poker hand and shows where your play differed from the mathematically optimal line, and when going against it would have actually made you more money.',
    image: '/assets/Poker_Analyzer.jpg',
    tags: ['Python', 'Game Theory', 'Poker'],
    status: 'in-progress',
    link: null,
  },
  {
    title: 'Gamertag Lookup',
    description: 'Look up a player once and get their stats from every game they play, pulled together from each platform\'s separate database.',
    image: '/assets/GamerTag_Lookup.jpeg',
    tags: ['Python', 'REST APIs', 'Data Aggregation'],
    status: 'planned',
    link: null,
  },
  {
    title: 'Steam Item Options Pricer',
    description: 'Takes historical prices for Counter-Strike skins and builds options chains on top of them, treating the skin market like a tradable asset.',
    image: '/assets/SteamSkin.webp',
    tags: ['Python', 'Derivatives', 'Time Series'],
    status: 'planned',
    link: null,
  },
];
---

<section id="projects" class="py-24 bg-slate-800">
  <div class="max-w-5xl mx-auto px-6">
    <h2 class="text-2xl font-semibold text-accent mb-6">Projects</h2>
    <p class="text-gray-400 mb-12">
      In my free time, I like to build personal projects that combine my personal interests with
      the technical skills I've developed. Here are a few with Github links attached: 
    </p>

    <div class="flex flex-col gap-8">
      {projects.map((project) => (
        <div class="bg-slate-900 rounded-xl border border-slate-700 overflow-hidden flex flex-col md:flex-row hover:border-accent/40 transition-all">
          <!-- Image -->
          <div class="md:w-[44%] flex-shrink-0 bg-slate-950/60 flex items-center justify-center p-4">
            <img
              src={project.image}
              alt={`${project.title} screenshot`}
              loading="lazy"
              class="w-full max-h-72 object-contain rounded-lg"
            />
          </div>

          <!-- Content -->
          <div class="flex-1 p-8 flex flex-col gap-4">
            <span class={`self-start text-xs font-medium px-2.5 py-1 rounded-full ${
              project.status === 'in-progress'
                ? 'bg-yellow-900/30 text-yellow-400'
                : 'bg-slate-700 text-gray-400'
            }`}>
              {project.status === 'in-progress' ? 'In Progress' : 'Planned'}
            </span>

            <div>
              <h4 class="text-xl font-semibold text-white mb-2">{project.title}</h4>
              <p class="text-gray-400 leading-relaxed">{project.description}</p>
            </div>

            <!-- Tags -->
            <div class="flex flex-wrap gap-2 mt-auto pt-2">
              {project.tags.map((tag) => (
                <span class="text-xs bg-slate-700 text-gray-300 px-2 py-0.5 rounded">{tag}</span>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
