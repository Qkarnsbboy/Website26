---
// projects/[slug].astro
// One page per project. Astro builds a page for each entry in the projects list.
import BaseLayout from '../../layouts/BaseLayout.astro';
import { projects } from '../../data/projects';
import type { Project } from '../../data/projects';

// Tell Astro which project pages to build.
export function getStaticPaths() {
  const paths = [];
  for (let i = 0; i < projects.length; i++) {
    paths.push({
      params: { slug: projects[i].slug },
      props: { project: projects[i], number: String(i + 1).padStart(2, '0') },
    });
  }
  return paths;
}

interface Props {
  project: Project;
  number: string;
}

const { project, number } = Astro.props;

// A live project shows its status and its image border in green.
let statusClass = 'text-muted';
let imageBorderClass = 'border-rule';
if (project.status === 'live') {
  statusClass = 'text-felt';
  imageBorderClass = 'border-felt';
}
---

<BaseLayout title={`${project.title} — Quincy Karns`} description={project.description}>
  <!-- Header: number, title, status -->
  <div class="flex flex-col gap-3">
    <span class="text-muted">{number} <span class="text-felt">//</span> project</span>
    <!-- The title links to the live site, if there is one -->
    <h1 class="text-2xl md:text-3xl font-bold">
      {project.link ? (
        <a href={project.link} target="_blank" rel="noopener noreferrer" class="hover:text-felt hover:underline">
          {project.title} ↗
        </a>
      ) : (
        project.title
      )}
    </h1>
    <span class={statusClass}>[{project.status}]</span>
  </div>

  <div class="border-t border-rule-strong"></div>

  <p class="text-base md:text-lg leading-normal max-w-[720px]">{project.description}</p>

  <!-- Every screenshot, each with a small title above it -->
  {project.images.map((image) => (
    <figure class="flex flex-col gap-2">
      {image.title && (
        <figcaption class="text-muted text-left">{image.title}</figcaption>
      )}
      <img
        src={image.src}
        alt={image.title ? `${project.title}: ${image.title}` : `${project.title} screenshot`}
        loading="lazy"
        class={`w-full h-auto border ${imageBorderClass}`}
      />
    </figure>
  ))}

  <!-- Link to the live demo, if there is one -->
  {project.link && (
    <a href={project.link} target="_blank" rel="noopener noreferrer" class="self-start text-felt hover:underline">
      open live demo ↗
    </a>
  )}
</BaseLayout>
