---
// projects/[slug].astro
// One page per project. Astro builds a page for each entry in the projects list.
import BaseLayout from '../../layouts/BaseLayout.astro';
import { projects } from '../../data/projects';
import type { Project } from '../../data/projects';

// Tell Astro which project pages to build.
export function getStaticPaths() {
  const paths = [];
  for (const project of projects) {
    paths.push({
      params: { slug: project.slug },
      props: { project: project },
    });
  }
  return paths;
}

interface Props {
  project: Project;
}

const { project } = Astro.props;

// A live project shows its status and its image border in green.
let statusClass = 'text-muted';
let imageBorderClass = 'border-rule';
if (project.status === 'live') {
  statusClass = 'text-felt';
  imageBorderClass = 'border-felt';
}
---

<BaseLayout title={`${project.title} — Quincy Karns`} description={project.description}>
  <!-- Header: title, status -->
  <div class="flex flex-col gap-3">
    <span class="text-muted"><span class="text-felt">//</span> project</span>
    <h1 class="text-2xl md:text-3xl font-bold">{project.title}</h1>
    <span class={statusClass}>[{project.status}]</span>
  </div>

  <div class="border-t border-rule-strong"></div>

  <p class="text-base md:text-lg leading-normal max-w-[720px]">{project.description}</p>

  <!-- Facts in ledger rows -->
  <dl class="flex flex-col border-t border-rule max-w-[720px]">
    <div class="grid grid-cols-[120px_minmax(0,1fr)] gap-4 py-3 border-b border-rule">
      <dt class="text-muted">tags</dt>
      <dd>{project.tags.join(', ').toLowerCase()}</dd>
    </div>
    {project.link && (
      <div class="grid grid-cols-[120px_minmax(0,1fr)] gap-4 py-3 border-b border-rule">
        <dt class="text-muted">demo</dt>
        <dd>
          <a href={project.link} target="_blank" rel="noopener noreferrer" class="text-felt hover:underline">
            open live demo ↗
          </a>
        </dd>
      </div>
    )}
  </dl>

  <img
    src={project.image}
    alt={`${project.title} screenshot`}
    class={`w-full aspect-video object-cover border ${imageBorderClass}`}
  />
</BaseLayout>
