---
// experience/[slug].astro
// One page per company. Each role at that company is a block with its bullets.
import BaseLayout from '../../layouts/BaseLayout.astro';
import { companies } from '../../data/experience';
import { projects } from '../../data/projects';
import type { Company } from '../../data/experience';

// Tell Astro which company pages to build.
// Experience numbers continue after the project numbers, like in the menu.
export function getStaticPaths() {
  const paths = [];
  for (let i = 0; i < companies.length; i++) {
    const number = String(projects.length + i + 1).padStart(2, '0');
    paths.push({
      params: { slug: companies[i].slug },
      props: { company: companies[i], number: number },
    });
  }
  return paths;
}

interface Props {
  company: Company;
  number: string;
}

const { company, number } = Astro.props;
---

<BaseLayout title={`${company.name} — Quincy Karns`}>
  <div class="flex flex-col gap-3">
    <span class="text-muted">{number} <span class="text-felt">//</span> experience</span>
    <h1 class="text-2xl md:text-3xl font-bold">{company.name}</h1>
  </div>

  <div class="border-t border-rule-strong"></div>

  {company.roles.map((role) => (
    <section class="flex flex-col gap-4 max-w-[760px]">
      <!-- Role title on the left, dates and place on the right -->
      <div class="flex flex-col sm:flex-row sm:justify-between gap-1">
        <h2 class="font-medium">{role.title}</h2>
        <span class="text-muted">{role.period} · {role.location}</span>
      </div>

      <ul class="flex flex-col border-t border-rule">
        {role.points.map((point) => (
          <li class="grid grid-cols-[24px_minmax(0,1fr)] gap-2 py-3 border-b border-rule">
            <span class="text-muted">–</span>
            <span>{point}</span>
          </li>
        ))}
      </ul>
    </section>
  ))}
</BaseLayout>
